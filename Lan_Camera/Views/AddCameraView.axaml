<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Lan_Camera.ViewModels"
             x:Class="Lan_Camera.Views.AddCameraView"
             x:DataType="vm:AddCameraViewModel">

	<Border x:Name="CameraAddBorder" VerticalAlignment="Center" CornerRadius="10" Background="#3333" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*">		
            <Button
                Grid.Column="0"
                Width="40" 
                Height="40" 
                Padding="10"
                Margin="10"
                CornerRadius="30"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                BorderBrush="Transparent"
                Background="#FAAA"
                Command="{Binding BackCommand}">
                <Image Source="avares://Lan_Camera/Assets/icons8-back-100.png"
                    Stretch="Uniform"
                    Width="50"
                    Height="50" />
            </Button>   

            <Grid x:Name="CameraAddStack" 
                Grid.Column="1" 
				HorizontalAlignment="Stretch" 
                VerticalAlignment="Center">	

                <StackPanel x:Name="CameraAddTextStack" HorizontalAlignment="Stretch">
                    <TextBox PlaceholderText="Camera name" Text="{Binding Name}" Margin="8" />
                    <TextBox PlaceholderText="IP address" Text="{Binding Address}" Margin="8" />
                </StackPanel>

                <Button x:Name="CameraAddButton"
                    Content="Add"
                    Width="80" 
                    Height="40" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="10" 
                    Command="{Binding AddCameraCommand}" />  
            </Grid>    
        </Grid>   
	</Border>

</UserControl>
